<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="opty.view.PacientesController">
    <AnchorPane styleClass="dashboard-root">
        <HBox spacing="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
            <!-- Columna Izquierda: Buscador y Lista de Pacientes -->
            <VBox spacing="15" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="480.0">
                <Label styleClass="section-title" text="PACIENTES" />
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscar" HBox.hgrow="ALWAYS" promptText="Buscar por nombre o documento..." />
                    <Button fx:id="btnBuscar" onAction="#onBuscar" styleClass="btn-secondary" text="Buscar" />
                    <Button fx:id="btnNuevo" onAction="#onMostrarRegistroPaciente" styleClass="btn-primary" text="+ Nuevo" />
                </HBox>
                
                <TableView fx:id="tablePacientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDocumento" text="Documento" prefWidth="90.0" />
                        <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="185.0" />
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="90.0" />
                        <TableColumn fx:id="colEdad" text="Edad" prefWidth="75.0" />
                    </columns>
                </TableView>
            </VBox>
            
            <!-- Columna Derecha: Detalles, Historial y Acciones -->
            <StackPane HBox.hgrow="ALWAYS" prefWidth="680.0">
                <!-- Estado 1: Vista Detalle (por defecto o al seleccionar) -->
                <VBox fx:id="paneDetalle" spacing="20" styleClass="card" visible="false">
                    <HBox alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label fx:id="lblPacienteNombre" styleClass="section-title" text="SELECCIONE UN PACIENTE" />
                            <Label fx:id="lblPacienteDocumento" styleClass="section-subtitle" text="DNI/RUC —" />
                        </VBox>
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button fx:id="btnIniciarVenta" onAction="#onIniciarVentaPaciente" styleClass="btn-secondary" text="Nueva Venta" />
                            <Button fx:id="btnEditarPaciente" onAction="#onEditarPaciente" styleClass="btn-info" text="Editar Paciente" />
                            <Button fx:id="btnNuevaConsultaTab" onAction="#onIniciarConsultaForm" styleClass="btn-primary" text="Nueva Consulta" />
                        </HBox>
                    </HBox>
                    
                    <Separator />
                    
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30" />
                            <ColumnConstraints percentWidth="70" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="25" />
                            <RowConstraints minHeight="25" />
                            <RowConstraints minHeight="25" />
                        </rowConstraints>
                        
                        <Label styleClass="form-label" text="Fecha Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblPacienteFecNac" styleClass="form-label" style="-fx-font-weight: normal;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label styleClass="form-label" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblPacienteTelf" styleClass="form-label" style="-fx-font-weight: normal;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="form-label" text="Tienda Afiliada:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblPacienteTienda" styleClass="form-label" style="-fx-font-weight: normal;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </GridPane>
                    
                    <TabPane fx:id="tabPanePaciente" VBox.vgrow="ALWAYS">
                        <tabs>
                            <Tab text="Historial de Consultas" closable="false">
                                <VBox spacing="10" style="-fx-padding: 15px 0 0 0;">
                                    <TableView fx:id="tableConsultas" VBox.vgrow="ALWAYS" prefHeight="250.0">
                                        <columns>
                                            <TableColumn fx:id="colConsFecha" text="Fecha" prefWidth="120.0" />
                                            <TableColumn fx:id="colConsMotivo" text="Motivo" prefWidth="250.0" />
                                            <TableColumn fx:id="colConsGraduacion" text="Graduación OD/OI" prefWidth="250.0" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>
                            <Tab text="Historial de Compras" closable="false">
                                <VBox spacing="10" style="-fx-padding: 15px 0 0 0;">
                                    <TableView fx:id="tableVentasPaciente" VBox.vgrow="ALWAYS" prefHeight="250.0">
                                        <columns>
                                            <TableColumn fx:id="colVentaTicket" text="Nº Ticket" prefWidth="120.0" />
                                            <TableColumn fx:id="colVentaFecha" text="Fecha" prefWidth="130.0" />
                                            <TableColumn fx:id="colVentaTipo" text="Comprobante" prefWidth="100.0" />
                                            <TableColumn fx:id="colVentaTotal" text="Total" prefWidth="90.0" />
                                            <TableColumn fx:id="colVentaEstado" text="Estado" prefWidth="100.0" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>
                            <Tab fx:id="tabNuevaConsulta" text="Nueva Consulta" closable="false">
                                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                                    <VBox spacing="15" style="-fx-padding: 15px 5px 0 5px;">
                                        <!-- Cuadro Informativo de última compra / venta -->
                                        <VBox spacing="6" style="-fx-background-color: -color-warm-beige-light; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: -color-warm-beige; -fx-border-width: 1px; -fx-border-radius: 8px;">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: -color-graphite-dark;" text="Información de Última Compra / Venta:" />
                                            <Label fx:id="lblUltimaVenta" style="-fx-text-fill: -color-info-text; -fx-font-weight: bold;" text="El paciente no registra compras previas." />
                                        </VBox>
                                        
                                        <Label styleClass="form-label" text="Motivo de la Consulta" />
                                        <TextField fx:id="txtConsMotivo" promptText="Describa el motivo de la atención..." />
                                        
                                        <!-- Cuadro de Parámetros Oculares (OD / OI) -->
                                        <VBox spacing="8" style="-fx-background-color: -color-warm-beige-light; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: -color-warm-beige; -fx-border-width: 1px; -fx-border-radius: 8px;">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: -color-graphite-dark;" text="Medidas Oculares Estructuradas (Se guardarán en formato JSON)" />
                                            <GridPane hgap="8" vgap="8">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="18" />
                                                    <ColumnConstraints percentWidth="13" />
                                                    <ColumnConstraints percentWidth="13" />
                                                    <ColumnConstraints percentWidth="13" />
                                                    <ColumnConstraints percentWidth="13" />
                                                    <ColumnConstraints percentWidth="15" />
                                                    <ColumnConstraints percentWidth="15" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints minHeight="25" />
                                                    <RowConstraints minHeight="30" />
                                                    <RowConstraints minHeight="30" />
                                                </rowConstraints>
                                                
                                                <!-- Headers -->
                                                <Label text="Ojo" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                <Label text="Esfera (ESF)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                <Label text="Cilindro (CIL)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                                <Label text="Eje (EJE)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                                <Label text="Adición (ADD)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                                                <Label text="A. V. (AV)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                                                <Label text="D. P. (DP)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="6" GridPane.rowIndex="0" />
                                                
                                                <!-- Ojo Derecho (OD) -->
                                                <Label text="DERECHO (OD)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtOdEsfera" promptText="-1.50" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtOdCilindro" promptText="-0.75" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtOdEje" promptText="180" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtOdAdicion" promptText="+2.00" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtOdAv" promptText="20/20" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtOdDp" promptText="32" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                                                
                                                <!-- Ojo Izquierdo (OI) -->
                                                <Label text="IZQUIERDO (OI)" style="-fx-font-weight: bold; -fx-font-size: 11px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtOiEsfera" promptText="-1.25" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtOiCilindro" promptText="-0.50" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtOiEje" promptText="175" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtOiAdicion" promptText="+2.00" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtOiAv" promptText="20/25" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="5" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtOiDp" promptText="31" style="-fx-font-size: 11px; -fx-padding: 5px;" GridPane.columnIndex="6" GridPane.rowIndex="2" />
                                            </GridPane>
                                        </VBox>
                                        
                                        <Label styleClass="form-label" text="Observaciones Clínicas" />
                                        <TextArea fx:id="txtConsObservaciones" prefHeight="80.0" promptText="Notas y recomendaciones adicionales..." />
                                        
                                        <GridPane hgap="15" vgap="10">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50" />
                                                <ColumnConstraints percentWidth="50" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints />
                                            </rowConstraints>
                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                <Label styleClass="form-label" text="Costo del Servicio (S/)" />
                                                <TextField fx:id="txtConsCosto" text="50.00" />
                                            </VBox>
                                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                <Label styleClass="form-label" text="Tipo de Comprobante" />
                                                <ComboBox fx:id="comboTipoComprobante" prefWidth="300.0" />
                                            </VBox>
                                        </GridPane>
                                        
                                        <HBox spacing="10" alignment="CENTER_RIGHT">
                                            <Button onAction="#onGuardarConsulta" styleClass="btn-primary" text="Guardar Consulta y Venta" />
                                        </HBox>
                                    </VBox>
                                </ScrollPane>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
                
                <!-- Estado 2: Formulario Nuevo Paciente -->
                <VBox fx:id="paneNuevoPaciente" spacing="20" styleClass="card" visible="false">
                    <Label styleClass="section-title" text="NUEVO PACIENTE" />
                    <Separator />
                    
                    <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                        <VBox spacing="15" style="-fx-padding: 5px;">
                            <GridPane hgap="15" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                </rowConstraints>
                                
                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="form-label" text="Tipo Documento" />
                                    <ComboBox fx:id="comboTipoDoc" prefWidth="300.0" />
                                </VBox>
                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label styleClass="form-label" text="Número Documento" />
                                    <TextField fx:id="txtPacDoc" promptText="Documento de identidad..." />
                                </VBox>
                                
                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label styleClass="form-label" text="Nombres" />
                                    <TextField fx:id="txtPacNombre" promptText="Nombres del paciente..." />
                                </VBox>
                                
                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label styleClass="form-label" text="Apellido Paterno" />
                                    <TextField fx:id="txtPacApeP" promptText="Apellido paterno..." />
                                </VBox>
                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label styleClass="form-label" text="Apellido Materno" />
                                    <TextField fx:id="txtPacApeM" promptText="Apellido materno..." />
                                </VBox>
                                
                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label styleClass="form-label" text="Teléfono" />
                                    <TextField fx:id="txtPacTelf" promptText="Número de celular..." />
                                </VBox>
                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label styleClass="form-label" text="Fecha de Nacimiento" />
                                    <DatePicker fx:id="dpPacFecNac" prefWidth="300.0" />
                                </VBox>
                            </GridPane>
                            
                            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15px 0 0 0;">
                                <Button onAction="#onCancelarRegistro" styleClass="btn-secondary" text="Cancelar" />
                                <Button onAction="#onGuardarPaciente" styleClass="btn-primary" text="Guardar Paciente" />
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </VBox>
                
                <!-- Estado 3: Placeholder inicial (No seleccionado) -->
                <VBox fx:id="panePlaceholder" alignment="CENTER" spacing="15" styleClass="card">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -color-graphite-light;" text="SELECCIONE O REGISTRE UN PACIENTE" />
                    <Label style="-fx-text-fill: -color-graphite-soft; -fx-text-alignment: center;" text="Busque un paciente en la lista izquierda para ver su historial clínico,&#10;o cree uno nuevo presionando el botón '+ Nuevo'." />
                </VBox>
            </StackPane>
        </HBox>
    </AnchorPane>
</ScrollPane>

